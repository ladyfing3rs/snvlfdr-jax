__pycache__/
*.pyc
.venv/
.direnv/
result/

# --- Large Biological Data (Input/Intermediate) ---
*.bam
*.bai
*.fa
*.fai
*.gz
*.sra
*.fastq
*.sam
*.amb
*.ann
*.bwt
*.pac
*.sa
*.bed

# --- Generated Large CSVs ---
paper_input.csv
